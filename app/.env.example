# --- Server ---
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
NODE_ENV=development

# --- Secrets ---
# 32-byte hex string used for session signing AND for cookie encryption of cheftap creds.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=

# --- Google OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {PUBLIC_BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage ---
# Path to SQLite file. On Fly, mount a volume to /data and use /data/app.sqlite.
DB_PATH=./data/app.sqlite

# --- Operational ---
# How many recipes to fetch in parallel from cheftap (be polite).
EXTRACT_CONCURRENCY=4
# How many Google Docs to create in parallel (Drive quota: ~1000/100s/user).
UPLOAD_CONCURRENCY=4
